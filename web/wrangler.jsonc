{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitness-daily-tasks",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // 22:05 UTC = 00:05 / 01:05 Israel time; 04:00 UTC is a safety re-run.
  // Every 5 minutes: create today's recurring tasks, send batched "new task" notifications, end-of-day reminders.
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  // No database_id: `wrangler deploy` provisions the D1 database automatically on first deploy
  // and writes the id back here. The Worker applies the schema itself on first request.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitness-daily-tasks",
      "migrations_dir": "migrations"
    }
  ],
  // Photos attached to tasks (auto-provisioned on deploy like the database)
  "kv_namespaces": [{ "binding": "FILES" }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "vars": {
    "APP_ENV": "production",
    "APP_NAME": "לו\"ז יומי",
    "TIMEZONE": "Asia/Jerusalem",
    "REMINDER_TIME": "20:00",
    "APP_URL": "https://fitness-daily-tasks.planet-kicker.workers.dev",
    "VAPID_SUBJECT": "mailto:admin@example.com"
  }
}
